"%(count)s stored URL result(s) were added; %(replaced)s existing "
"result(s) were replaced."
msgstr ""
"Se agregaron %(count)s resultado(s) de URL y se reemplazaron %(replaced)s"
" resultado(s) existentes."

#: app/routes/experiments.py:609
#, python-format
msgid "%(count)s stored URL result(s) were added."
msgstr "Se agregaron %(count)s resultado(s) por URL almacenados."

#: app/routes/experiments.py:611
msgid ""
"No results were added because every selected URL already exists in the "
"destination experiment."
msgstr ""
"No se agregó ningún resultado porque todas las URLs seleccionadas ya "
"existen en el experimento de destino."

#: app/routes/experiments.py:624 app/routes/experiments.py:792
#: app/routes/experiments.py:867 app/routes/experiments.py:1468
msgid "The requested evaluation experiment does not exist."
msgstr "El experimento de evaluación solicitado no existe."

#: app/routes/experiments.py:666
msgid "Select an exported .warp experiment file."
msgstr "Selecciona un archivo de experimento .warp exportado."

#: app/routes/experiments.py:674
msgid "The selected file is not a supported experiment export."
msgstr "El archivo seleccionado no es una exportación de experimento compatible."

#: app/routes/experiments.py:771
msgid "The experiment could not be imported."
msgstr "No fue posible importar el experimento."

#: app/routes/experiments.py:775
#, python-format
msgid "%(count)s imported URL result(s) were added."
msgstr "Se agregaron %(count)s resultado(s) por URL importados."

#: app/routes/experiments.py:798 app/templates/experiments.html:77
msgid "A running evaluation experiment cannot be deleted."
msgstr "No se puede eliminar un experimento de evaluación en ejecución."

#: app/routes/experiments.py:814
msgid "The evaluation experiment could not be deleted from the database."
msgstr "No se pudo eliminar el experimento de evaluación de la base de datos."

#: app/routes/experiments.py:832
msgid "Evaluation experiment and all associated data were deleted."
msgstr ""
"El experimento de evaluación y todos sus datos asociados fueron "
"eliminados."

#: app/routes/experiments.py:835
msgid ""
"The database records were deleted, but some generated files could not be "
"removed."
msgstr ""
"Los registros de la base de datos fueron eliminados, pero algunos "
"archivos generados no pudieron borrarse."

#: app/routes/experiments.py:853
msgid "Select at least one URL result."
msgstr "Selecciona al menos un resultado de URL."

#: app/routes/experiments.py:870
msgid "URL results cannot be removed while an experiment is running."
msgstr ""
"No se pueden eliminar resultados de URL mientras se ejecuta un "
"experimento."

#: app/routes/experiments.py:887
msgid "The selected URL results are no longer available."
msgstr "Los resultados de URL seleccionados ya no están disponibles."

#: app/routes/experiments.py:923
msgid "The selected URL results could not be removed."
msgstr "No se pudieron eliminar los resultados de URL seleccionados."

#: app/routes/experiments.py:938
msgid "The experiment was deleted because all of its URL results were removed."
msgstr "El experimento se eliminó porque se quitaron todos sus resultados de URL."

#: app/routes/experiments.py:940
msgid "The experiment was deleted, but some generated files could not be removed."
msgstr ""
"El experimento se eliminó, pero no se pudieron borrar algunos archivos "
"generados."

#: app/routes/experiments.py:953
#, python-format
msgid "%(count)s URL result(s) were removed from the experiment."
msgstr "Se eliminaron %(count)s resultado(s) de URL del experimento."

#: app/routes/experiments.py:955
msgid ""
"The URL results were removed, but some generated files could not be "
"deleted."
msgstr ""
"Los resultados de URL se eliminaron, pero no se pudieron borrar algunos "
"archivos generados."

