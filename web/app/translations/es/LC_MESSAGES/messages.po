msgstr "Espera a que termine la evaluación activa antes de reintentar sitios."

msgid "No failed sampled sites are awaiting their single retry."
msgstr "No hay sitios fallidos de la muestra pendientes de su único reintento."

msgid "The failed sites could not be retried."
msgstr "No fue posible reintentar los sitios fallidos."

#, python-format
msgid "%(count)s failed site(s) were queued for one controlled retry."
msgstr "Se puso en cola un reintento controlado para %(count)s sitio(s) fallido(s)."

