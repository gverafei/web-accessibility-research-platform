msgid "No URLs were provided and no valid internal dataset was found."
msgstr "No se proporcionaron URLs y no se encontró un dataset interno válido."

#: app/routes/experiments.py:1733
msgid "The evaluation experiment was queued and will continue in the background."
msgstr ""
"El experimento de evaluación fue puesto en cola y continuará en segundo "
"plano."

#: app/routes/experiments.py:2032
msgid "Accessibility evaluation experiment completed successfully."
msgstr "El experimento de evaluación de accesibilidad finalizó correctamente."

#: app/routes/experiments.py:2042
#, python-format
msgid "The accessibility evaluation experiment could not be completed: %(error)s"
msgstr ""
"No se pudo completar el experimento de evaluación de accesibilidad: "
"%(error)s"

