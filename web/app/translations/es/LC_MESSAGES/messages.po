#: app/routes/experiments.py:212
msgid "Configuration saved. New experiments will use these values."
msgstr "Configuración guardada. Los nuevos experimentos utilizarán estos valores."

#: app/routes/experiments.py:234
msgid "The confirmation text did not match. No experiments were deleted."
msgstr "El texto de confirmación no coincide. No se eliminó ningún experimento."

#: app/routes/experiments.py:244
msgid "Experiments cannot be cleared while an evaluation is queued or running."
msgstr ""
"No se pueden eliminar los experimentos mientras haya una evaluación en "
"cola o en ejecución."

#: app/routes/experiments.py:264
msgid "The experiments could not be cleared from the database."
msgstr "No se pudieron eliminar los experimentos de la base de datos."

#: app/routes/experiments.py:284
#, python-format
msgid ""
"All %(count)s evaluation experiments and their generated files were "
"deleted."
msgstr ""
"Se eliminaron los %(count)s experimentos de evaluación y sus archivos "
"generados."

#: app/routes/experiments.py:286
msgid ""
"All database experiments were deleted, but some generated files could not"
" be removed."
msgstr ""
"Los registros de la base de datos fueron eliminados, pero algunos "
"archivos generados no pudieron borrarse."

#: app/routes/experiments.py:460 app/routes/experiments.py:461
msgid "Select at least one stored URL result."
msgstr "Selecciona al menos un resultado por URL almacenado."

#: app/routes/experiments.py:480 app/routes/experiments.py:481
msgid "The selected stored results no longer exist."
msgstr "Los resultados almacenados seleccionados ya no existen."

#: app/routes/experiments.py:489
#, python-format
msgid "Combined evaluation %(timestamp)s"
msgstr "Evaluación combinada %(timestamp)s"

