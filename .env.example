# Application
APP_TIMEZONE=America/Mexico_City
SECRET_KEY=replace_for_your_local_environment
EVALUATOR_URL=http://evaluator:3000
DOCKER_WEB_IMAGE=gverafei/accessibility-web
DOCKER_EVALUATOR_IMAGE=gverafei/accessibility-evaluator

# MySQL
MYSQL_DATABASE=accessibility_experiments
MYSQL_USER=access_user
MYSQL_PASSWORD=access_pass
MYSQL_ROOT_PASSWORD=root_pass
DB_HOST=db
DB_PORT=3306
DB_NAME=accessibility_experiments
DB_USER=access_user
DB_PASSWORD=access_pass

# Optional semantic evaluation through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional WAVE API
WAVE_API_KEY=
WAVE_REPORT_TYPE=2
WAVE_EVAL_DELAY_MS=2000
WAVE_COST_PER_CREDIT_USD=0.04

# Dynamic-page stabilization
PAGE_LOAD_TIMEOUT_MS=60000
NETWORK_IDLE_TIMEOUT_MS=15000
PAGE_SETTLE_DELAY_MS=2000
DOM_STABILITY_WINDOW_MS=1500
DOM_STABILITY_TIMEOUT_MS=10000
ENABLE_LAZY_LOAD_SCROLL=true
SCROLL_STEP_PX=700
SCROLL_DELAY_MS=400
MAX_SCROLL_STEPS=30
